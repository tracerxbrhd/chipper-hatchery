{
  "$schema": "./node_modules/@tgcloud/cli/schema/tgcloud.json",
  "static": {
    "spa": true,
    // Let browsers cache content-hashed files for a year (Vite puts them here):
    "immutable": ["/assets/*"],
    "headers": [{ "path": "/*", "set": { "Referrer-Policy": "no-referrer" } }],
    // The build output folder, hosted as the Mini App:
    "source": "dist"
  }
}
